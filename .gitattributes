# Normalização de fim de linha (repositório editado em Windows e macOS)
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Git LFS: pesos e modelo Core ML
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
**/*.mlpackage/Data/** filter=lfs diff=lfs merge=lfs -text

# Binários pequenos versionados normalmente
*.png binary
*.jpg binary
