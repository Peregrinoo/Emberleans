{
  "meta": {
    "name": "EmberLens design tokens",
    "version": "1.0.0",
    "note": "Cores de interface mapeiam para cores semânticas do iOS; valores hex são referência."
  },
  "color": {
    "brand": {
      "ember": {
        "50": "#FBEEE8",
        "100": "#F6D9CC",
        "300": "#EC8157",
        "500": "#D96B45",
        "600": "#C4532C",
        "700": "#A3421F",
        "900": "#4A1D0E"
      },
      "ink": "#151312",
      "graphite": "#2A2624",
      "stone": "#8A847F",
      "mist": "#E7E2DC",
      "paper": "#F5F2EE"
    },
    "semantic": {
      "background": {
        "ios": "systemBackground",
        "light": "#FFFFFF",
        "dark": "#000000"
      },
      "surface": {
        "ios": "secondarySystemBackground",
        "light": "#F2F2F7",
        "dark": "#1C1C1E"
      },
      "textPrimary": {
        "ios": "label",
        "light": "#000000",
        "dark": "#FFFFFF"
      },
      "textSecondary": {
        "ios": "secondaryLabel",
        "light": "rgba(60,60,67,0.60)",
        "dark": "rgba(235,235,245,0.60)"
      },
      "textTertiary": {
        "ios": "tertiaryLabel",
        "light": "rgba(60,60,67,0.30)",
        "dark": "rgba(235,235,245,0.30)"
      },
      "accent": {
        "ios": "AccentColor (asset)",
        "light": "#C4532C",
        "dark": "#C4532C"
      },
      "accentText": {
        "ios": "EmberText (asset)",
        "light": "#C4532C",
        "dark": "#EC8157"
      },
      "onAccent": {
        "ios": "white",
        "light": "#FFFFFF",
        "dark": "#FFFFFF"
      },
      "border": {
        "ios": "separator",
        "light": "rgba(60,60,67,0.29)",
        "dark": "rgba(84,84,88,0.65)"
      },
      "disabledFill": {
        "ios": "quaternarySystemFill",
        "light": "rgba(120,120,128,0.12)",
        "dark": "rgba(120,120,128,0.24)"
      },
      "disabledText": {
        "ios": "tertiaryLabel",
        "light": "rgba(60,60,67,0.30)",
        "dark": "rgba(235,235,245,0.30)"
      },
      "error": {
        "ios": "systemRed",
        "light": "#FF3B30",
        "dark": "#FF453A"
      },
      "success": {
        "ios": "systemGreen",
        "light": "#34C759",
        "dark": "#30D158"
      },
      "barTrack": {
        "ios": "quaternarySystemFill",
        "light": "rgba(116,116,128,0.08)",
        "dark": "rgba(118,118,128,0.18)"
      },
      "barNeutral": {
        "ios": "systemGray3",
        "light": "#C7C7CC",
        "dark": "#48484A"
      },
      "lensFill": {
        "ios": "LensFill (asset)",
        "light": "#F1ECE6",
        "dark": "#1E1B19"
      }
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "screenMargin": 20,
    "sectionGap": 32
  },
  "radius": {
    "photo": 16,
    "button": 14,
    "notice": 12,
    "group": 12,
    "sheet": 28,
    "bar": 3
  },
  "size": {
    "buttonHeight": 52,
    "minTouchTarget": 44,
    "navBar": 44,
    "barHeight": 6,
    "photoPreviewMaxHeight": 440,
    "photoResultMaxHeight": 300
  },
  "typography": {
    "largeTitle": ".largeTitle bold",
    "title": ".title bold",
    "title2": ".title2 bold",
    "title3": ".title3 semibold",
    "headline": ".headline",
    "body": ".body",
    "callout": ".callout",
    "subheadline": ".subheadline",
    "footnote": ".footnote",
    "caption": ".caption",
    "label": ".caption2 medium, uppercase, tracking +6%",
    "numeric": ".monospacedDigit()"
  },
  "motion": {
    "navigation": "NavigationStack push (nativo)",
    "result": "sem atraso artificial; transição padrão",
    "reduceMotion": "substituir transições por crossfade; nenhuma animação decorativa"
  }
}